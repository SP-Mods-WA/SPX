<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_glass_card.xml -->
<!-- Semi-transparent dark glass card with neon purple border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Neon border glow (outer layer) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#557B61FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Glass inner fill -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC0D0B1E" />
            <corners android:radius="23dp" />
        </shape>
    </item>

</layer-list>
