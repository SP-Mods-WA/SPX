<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppTheme: Theme.Material -> Theme.AppCompat fix කළා -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="NoStatusBar" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- SplashTheme: Theme.Material -> Theme.AppCompat fix කළා -->
    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- LoginTheme -->
    <style name="LoginTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#05030F</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">#05030F</item>
        <item name="android:navigationBarColor">#05030F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Field label style -->
    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#9CA3AF</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Theme.SPX -->
    <style name="Theme.SPX" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#FF00CC</item>
        <item name="colorPrimaryDark">#05030F</item>
        <item name="colorAccent">#7B5CF0</item>
        <item name="android:windowBackground">#05030F</item>
        <item name="android:statusBarColor">#05030F</item>
        <item name="android:navigationBarColor">#05030F</item>
    </style>

    <!-- Theme.SPX.Fullscreen -->
    <style name="Theme.SPX.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>
