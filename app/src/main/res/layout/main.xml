<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05030F"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- Logo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLogoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPX"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FF00CC" />
                <!-- Note: Use a gradient text effect in code for the pink-to-blue gradient -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIDEO EDITOR"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:textColor="#AAAAAA" />
            </LinearLayout>

            <!-- Notification Icon -->
            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_notification"
                android:padding="4dp"
                android:layout_marginEnd="16dp"
                android:tint="#FFFFFF" />

            <!-- Settings Icon -->
            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_settings"
                android:padding="4dp"
                android:tint="#FFFFFF" />

        </LinearLayout>

        <!-- ===== HERO BANNER ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <!-- Background gradient image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivHeroBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/hero_bg_gradient"
                    android:scaleType="centerCrop" />

                <!-- Clapperboard image (right side) -->
                <ImageView
                    android:id="@+id/ivClapperboard"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="0dp"
                    android:src="@drawable/ic_clapperboard_neon"
                    android:scaleType="fitEnd" />

                <!-- Text content (left side) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="140dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Project"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FF2DC8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start editing your video\nand create something\namazing."
                        android:textSize="12sp"
                        android:textColor="#CCCCCC"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp" />

                    <!-- New Project Button -->
                    <Button
                        android:id="@+id/btnNewProject"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:text="+ New Project"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_new_project"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />

                </LinearLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== TOOLS SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="28dp">

            <!-- Tools Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tools"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvToolsSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textSize="14sp"
                    android:textColor="#7B5CF0" />

            </LinearLayout>

            <!-- Tools Grid Row -->
<com.spmods.spx.webview.YTProWebView
		android:id="@+id/web"
		android:layout_width="0.0dp"
		android:layout_height="0.0dp"/>

        </LinearLayout>

        <!-- Bottom padding for scroll -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
